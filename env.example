#Copy this file to .env and fill in the values
#ARI variable
ARI_URL=http://172.17.0.1:8088/ari
ARI_WS_URL=ws://172.17.0.1:8088/ari/events
ARI_IP=172.17.0.1
ARI_USERNAME=ariuser
ARI_PASSWORD=aripass
ARI_APPLICATION_NAME=ari-stt-tts

# Speech-to-text & AI services
DEEPGRAM_API_KEY=your_deepgram_api_key
GEMINI_API_KEY=your_gemini_api_key

# External access (used for ARI externalMedia, RTP, etc.) (In progress)
EXTERNAL_HOST_IP=localhost
EXTERNAL_MEDIA_PORT=4002
ARI_EXTERNAL_MEDIA_BASE_URL=http://localhost:8088
